{
  "name": "black-tallow-site",
  "version": "1.0.0",
  "private": true,
  "description": "The Black Tallow website, built with Eleventy.",
  "type": "module",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "check-links": "node scripts/check-links.mjs _site",
    "check": "eleventy && node scripts/check-links.mjs _site",
    "images": "node scripts/images.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "@11ty/eleventy-img": "7.1.1",
    "@11ty/eleventy-plugin-rss": "3.1.0",
    "sharp": "0.35.5"
  }
}
