{#- A list of posts: title, date, one-line summary. Set `posts` and `headingLevel` (2 or 3) before including. -#}
<ol class="post-list" role="list">
  {%- for post in posts %}
  <li class="post-list__item">
    <h{{ headingLevel }} class="post-list__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h{{ headingLevel }}>
    <p class="post-list__date"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>{% if post.data.draft %} <span class="todo">Draft: not in the build</span>{% endif %}</p>
    <p>{{ post.data.summary }}</p>
  </li>
  {%- endfor %}
</ol>
