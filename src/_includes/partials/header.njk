{#- The small header on every page but home (the home page's hero carries the wordmark). -#}
{%- set wm = images.wordmark[0] %}
<header class="site-header">
  <a class="site-header__home" href="/">
    <img src="{{ wm.src }}" width="{{ wm.width }}" height="{{ wm.height }}" alt="Black Tallow, home" eleventy:ignore>
  </a>
  <nav class="site-header__nav" aria-label="Main">
    <a href="/devlog/"{% if page.url == "/devlog/" %} aria-current="page"{% endif %}>Devlog</a>
  </nav>
</header>
