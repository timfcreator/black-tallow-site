<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {#- siteUrl (src/_data/siteUrl.js): the domain, else the address GitHub Pages reports, else nothing. #}
  {%- set baseUrl = siteUrl if siteUrl.indexOf("http://localhost") != 0 else "" %}
  {%- set fullTitle = (title + " | " + site.name) if title else (site.name + " | " + site.tagline) %}
  {%- set desc = summary or description or site.description %}
  {%- set og = ogImage or images["og-image"] %}
  <title>{{ fullTitle }}</title>
  <meta name="description" content="{{ desc }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- elif baseUrl %}
  <link rel="canonical" href="{{ baseUrl }}{{ page.url }}">
  {%- endif %}
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} devlog" href="/devlog/feed.xml">
  <meta name="theme-color" content="#000000">
  <meta name="color-scheme" content="dark">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="preload" href="/assets/fonts/montserrat/Montserrat-SemiBold-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css">

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ desc }}">
  <meta property="og:locale" content="en_AU">
  {%- if ogType == "article" %}
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.name }}">
  <meta name="twitter:description" content="{{ desc }}">
  {%- if baseUrl %}
  {#- Link previews need absolute URLs, so they wait for a published address. #}
  <meta property="og:url" content="{{ baseUrl }}{{ page.url }}">
  <meta property="og:image" content="{{ baseUrl }}{{ og.src }}">
  <meta property="og:image:width" content="{{ og.width }}">
  <meta property="og:image:height" content="{{ og.height }}">
  {%- set ogAlt = imageAlt if ogImage else "The words Black Tallow above a lit candle and a sword, on black." %}
  <meta property="og:image:alt" content="{{ ogAlt }}">
  <meta name="twitter:image" content="{{ baseUrl }}{{ og.src }}">
  <meta name="twitter:image:alt" content="{{ ogAlt }}">
  {%- endif %}
  {%- if site.cloudflareAnalyticsToken %}
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cloudflareAnalyticsToken }}"}'></script>
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {%- if not hideHeader %}
  {% include "partials/header.njk" %}
  {%- endif %}
  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
</body>
</html>
